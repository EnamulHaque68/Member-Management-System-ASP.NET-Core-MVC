@model IEnumerable<MemberType>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Member Type List</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
            
                <a asp-action="Edit" asp-route-id="@item.TypeId" class="btn btn-success">
                    <i class="fas fa-edit"></i> Edit
                </a>|
                <a asp-action="Details" asp-route-id="@item.TypeId" class="btn btn-primary">
                    <i class="fas fa-info-circle"></i> Details
                </a>|
                <a asp-action="Delete" asp-route-id="@item.TypeId" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this item?');">
                    <i class="fas fa-trash-alt"></i> Delete
                </a>

            </td>
        </tr>
}
    </tbody>
</table>
