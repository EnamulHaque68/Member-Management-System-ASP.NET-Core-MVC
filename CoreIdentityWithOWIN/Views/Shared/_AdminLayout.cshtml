<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <title>@ViewBag.Title - Admin Panel</title>
    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #343a40;
        }

            .sidebar a {
                color: white;
                text-decoration: none;
                padding: 10px 15px;
                display: block;
            }

                .sidebar a:hover {
                    background-color: #007bff;
                }

        .main-content {
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 p-0 sidebar">
                <div class="p-3">
                    <h5 class="text-white">Admin Panel</h5>
                    <hr class="bg-white" />
                    <a href="/Members"><i class="fas fa-users"></i> Members</a>
                    <a href="/MemberTypes"><i class="fas fa-tags"></i> Member Types</a>
                    <a href="/Admin/ListRoles"><i class="fas fa-user-shield"></i> Manage Roles</a>
                    <a href="/Admin/Index"><i class="fas fa-users"></i> All Users</a>
                    <a href="/Home"><i class="fas fa-home"></i> Home</a>
                </div>
            </div>
            <div class="col-md-10 main-content">
                <nav class="navbar navbar-expand-lg navbar-light bg-light mb-3">
                    <div class="container-fluid">
                        <span class="navbar-brand">Welcome, @User.Identity?.Name</span>
                        <div class="ms-auto">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                            </form>
                        </div>
                    </div>
                </nav>

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>